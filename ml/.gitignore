# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# Data (large files, not versioned)
data/raw/
data/processed/

# Dataset versions: manifest.csv is the record and is versioned; everything else
# under a version directory is image data and is not. Written as ignore-all plus
# explicit exceptions rather than a list of extensions, so no camera file slips
# in on an extension or a casing nobody enumerated — the CI runner's filesystem
# is case-sensitive and cameras produce .JPG. See docs/ml/collection-protocol.md.
data/datasets/**
!data/datasets/**/
!data/datasets/**/manifest.csv
!data/datasets/**/admission-rejected.csv

# Keras checkpoints (large, not versioned)
models/**/model.h5

# Jupyter
.ipynb_checkpoints/

# pytest
.pytest_cache/

# OS
.DS_Store
Thumbs.db
