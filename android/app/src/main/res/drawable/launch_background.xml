<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window before Flutter's first frame on Android 11 and earlier:
     the Dart splash's tile and mark, centred on the app background, at the
     splash's sizes (SPEC 0089). Android 12 and later show launch_icon.xml in
     the system splash screen instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="120dp"
        android:height="120dp"
        android:drawable="@drawable/launch_tile"
        android:gravity="center" />
    <item
        android:width="64dp"
        android:height="64dp"
        android:drawable="@drawable/launch_mark"
        android:gravity="center" />
</layer-list>
